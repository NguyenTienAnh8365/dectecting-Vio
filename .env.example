# Copy -> .env rồi điền. config.py tự nạp. .env đã gitignore.

# Camera live — "cam1=rtsp://user:pass@ip/stream;cam2=..." (rỗng = chỉ chức năng upload).
LIVE_CAMS=

# Classifier checkpoint sau khi fine-tune (rỗng = chạy dummy để test transport).
VIO_CKPT=weights/vio_r2plus1d.pt
VIO_BACKBONE=r2plus1d_18

# YOLO person-gate (tự tải lần đầu).
GATE_MODEL=yolo11n.pt
